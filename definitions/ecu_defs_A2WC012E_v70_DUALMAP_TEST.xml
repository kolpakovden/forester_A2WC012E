        <!-- v70 fail-safe static Target Boost selector.
             Active Map is stored at 0x6C0C0 and evaluated by the ROM helper:
             raw value exactly 1 selects Map 2; every other raw byte selects Map 1.
             RomRaider displays raw 0 as Map 1 and raw 1 as Map 2,
             so the user-facing selector accepts 1 or 2. -->
        <table type="2D" name="Active Map" category="Dual Map - Target Boost" storagetype="uint8" endian="big" sizey="1" userlevel="1" storageaddress="0x6C0C0">
            <scaling units="Map (1=Map 1, 2=Map 2)" expression="x+1" to_byte="x-1" format="#" fineincrement="1" coarseincrement="1" min="1" max="2" />
            <table type="Static Y Axis" name="Dual Map"><data>Active Map</data></table>
            <description>User-facing value 1 selects Map 1 (raw 0). User-facing value 2 selects Map 2 (raw 1). The ROM helper is fail-safe: only raw value exactly 1 selects Map 2; raw 0, 2, 255, or any other unexpected raw value selects Map 1. Change this calibration value offline before flashing; this definition does not provide dynamic map switching.</description>
        </table>

        <table type="3D" name="Target Boost - Map 1" category="Dual Map - Target Boost" storagetype="uint16" endian="big" sizex="8" sizey="12" userlevel="1" logparam="E52" storageaddress="0x56B08">
            <scaling category="Metric" units="Boost Target (bar absolute)" expression="x*.001333224" to_byte="x/.001333224" format="#0.000" fineincrement=".01" coarseincrement=".1" />
            <scaling category="Standard" units="Boost Target (psi relative sea level)" expression="(x-760)*.01933677" to_byte="(x/.01933677)+760" format="0.00" fineincrement=".01" coarseincrement=".5" />
            <table type="X Axis" name="Throttle Plate Opening Angle" storagetype="float" endian="little" sizex="8" storageaddress="0x56AB8" logparam="E38">
                <scaling units="%" expression="x/.84" to_byte="x*.84" format="0.0" fineincrement=".3" coarseincrement="1" />
            </table>
            <table type="Y Axis" name="Engine Speed" storagetype="float" endian="little" sizey="12" storageaddress="0x56AD8" logparam="P8">
                <scaling units="RPM" expression="x" to_byte="x" format="#" fineincrement="50" coarseincrement="100" />
            </table>
            <description>Original Target Boost table. Map 1 and Map 2 share the stock X and Y axes.</description>
        </table>

        <table type="3D" name="Target Boost - Map 2" category="Dual Map - Target Boost" storagetype="uint16" endian="big" sizex="8" sizey="12" userlevel="1" logparam="E52" storageaddress="0x76B08">
            <scaling category="Metric" units="Boost Target (bar absolute)" expression="x*.001333224" to_byte="x/.001333224" format="#0.000" fineincrement=".01" coarseincrement=".1" />
            <scaling category="Standard" units="Boost Target (psi relative sea level)" expression="(x-760)*.01933677" to_byte="(x/.01933677)+760" format="0.00" fineincrement=".01" coarseincrement=".5" />
            <table type="X Axis" name="Throttle Plate Opening Angle" storagetype="float" endian="little" sizex="8" storageaddress="0x56AB8" logparam="E38">
                <scaling units="%" expression="x/.84" to_byte="x*.84" format="0.0" fineincrement=".3" coarseincrement="1" />
            </table>
            <table type="Y Axis" name="Engine Speed" storagetype="float" endian="little" sizey="12" storageaddress="0x56AD8" logparam="P8">
                <scaling units="RPM" expression="x" to_byte="x" format="#" fineincrement="50" coarseincrement="100" />
            </table>
            <description>Second Target Boost table stored at 0x76B08. Initially byte-for-byte identical to Map 1 and using the same stock X and Y axes.</description>
        </table>

